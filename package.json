{
  "name": "hair-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "check:arch": "node scripts/check-arch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "precommit": "node scripts/precommit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hair-lab/eslint-config": "workspace:*",
    "@hair-lab/prettier-config": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
