#!/bin/sh
# Pre-commit проверка: prettier и eslint по staged-файлам, check:arch при правках src.
# Подключается через `git config core.hooksPath .githooks` (это делает `prepare` в package.json).
# Обойти: `git commit --no-verify`.
set -e
exec node "$(git rev-parse --show-toplevel)/scripts/precommit.mjs"
