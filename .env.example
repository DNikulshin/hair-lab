# ── API: общее (apps/api) ─────────────────────────────────────────────────────
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info
# Часовой пояс салона: время в БД хранится в UTC, в нём считаются «рабочие» сутки.
SALON_TIMEZONE=Europe/Moscow
# Источники, которым разрешены запросы к API (через запятую).
CORS_ORIGINS=http://localhost:3000
# Базовый адрес сайта для ссылок в письмах и возвратов после оплаты.
APP_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hair_lab:change_me@localhost:5432/hair_lab?schema=public

# ── Аутентификация клиента (issue #6) ────────────────────────────────────────
# Случайная строка не короче 32 символов: openssl rand -base64 48
AUTH_SECRET=

# ── ЮKassa (issue #8) ────────────────────────────────────────────────────────
# test — тестовый магазин, live — реальные списания. Переключать осознанно.
PAYMENTS_MODE=test
YOOKASSA_SHOP_ID=
# Секрет. Только в .env и GitHub Secrets, в репозиторий не попадает.
YOOKASSA_SECRET_KEY=
# Куда вернуть клиента после оплаты.
YOOKASSA_RETURN_URL=http://localhost:3000/booking/success
# Код ставки НДС для чека (54-ФЗ). 1 — без НДС; уточнить у бухгалтерии.
YOOKASSA_VAT_CODE=1
# Контакт для чеков (email или телефон салона, не клиента).
PAYMENT_RECEIPT_EMAIL=

# ── Почта (issue #9) ─────────────────────────────────────────────────────────
# Выбран Google Workspace: smtp.gmail.com:465 (SSL), пароль приложения.
# Альтернатива (если переедем на доменную почту Яндекса): smtp.yandex.ru:465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Секрет: пароль приложения, не пароль от почтового ящика.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Стриж Lab

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Публичные значения встраиваются в бандл на этапе сборки: секретов здесь быть не может.
# Для Docker-образа передаются как build-args (см. apps/web/Dockerfile).
NEXT_PUBLIC_SITE_NAME=Стриж Lab
NEXT_PUBLIC_SITE_SHORT_NAME=Стриж
NEXT_PUBLIC_SITE_DESCRIPTION=Салон красоты в Москве: услуги, мастера и онлайн-запись.
NEXT_PUBLIC_SITE_URL=https://strizhlab.ru
NEXT_PUBLIC_SITE_CITY=Москва
NEXT_PUBLIC_SITE_TIMEZONE=Europe/Moscow
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Только для docker-compose.prod.yml на VPS ────────────────────────────────
# Значения подставляет release.yml из GitHub Secrets/Variables.
# POSTGRES_USER=hair_lab
# POSTGRES_PASSWORD=
# POSTGRES_DB=hair_lab
# GHCR_IMAGE_API=ghcr.io/<owner>/hair-lab-api
# GHCR_IMAGE_WEB=ghcr.io/<owner>/hair-lab-web
# IMAGE_TAG=
# WEB_PORT=3000
