{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "db:generate": {
      "outputs": ["src/generated/prisma/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "test:int": {
      // DATABASE_URL пробрасывается в задачу явно: в strict-режиме turbo фильтрует окружение.
      "env": ["DATABASE_URL"],
      "dependsOn": ["db:generate"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
