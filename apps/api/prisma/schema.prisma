// Схема БД салона: услуги, мастера, расписание и записи.
// Время хранится в UTC (timestamptz); часовой пояс салона — только в конфиге (SALON_TIMEZONE).
// Ограничения, которые Prisma не выражает (EXCLUDE, CHECK), добавляются в SQL-миграции.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Категория услуг каталога. Публично отдаются только активные категории.
model ServiceCategory {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  services Service[]

  @@map("service_categories")
}

/// Услуга с фиксированным прайсом: цена в копейках, длительность в минутах.
model Service {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  durationMin  Int     @map("duration_min")
  priceKopecks Int     @map("price_kopecks")
  isActive     Boolean @default(true) @map("is_active")
  sortOrder    Int     @default(0) @map("sort_order")

  // Категория необязательна: услуги без категории публичны. NOT NULL — отдельной contract-миграцией.
  categoryId String?          @map("category_id") @db.Uuid
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  masters      MasterService[]
  appointments Appointment[]

  @@index([categoryId])
  @@map("services")
}

/// Мастер. Удаление не физическое: isActive = false сохраняет историю записей.
model Master {
  id       String  @id @default(uuid()) @db.Uuid
  fullName String  @map("full_name")
  bio      String?
  photoUrl String? @map("photo_url")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  services     MasterService[]
  workingTime  MasterWorkingHours[]
  exceptions   ScheduleException[]
  appointments Appointment[]

  @@map("masters")
}

/// Какие услуги оказывает мастер (m-n).
model MasterService {
  masterId  String @map("master_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  master  Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
  @@index([serviceId])
  @@map("master_services")
}

/// Еженедельный шаблон рабочих часов: день недели и минуты от полуночи в TZ салона.
/// Абсолютное время не хранится — переход на летнее/зимнее время учитывается при генерации слотов.
model MasterWorkingHours {
  id          String @id @default(uuid()) @db.Uuid
  masterId    String @map("master_id") @db.Uuid
  dayOfWeek   Int    @map("day_of_week")
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute")

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, dayOfWeek, startMinute])
  @@map("master_working_hours")
}

/// Исключение из расписания: отпуск, больничный и т. п. Абсолютный интервал в UTC.
model ScheduleException {
  id       String                @id @default(uuid()) @db.Uuid
  masterId String                @map("master_id") @db.Uuid
  kind     ScheduleExceptionKind
  startsAt DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime              @map("ends_at") @db.Timestamptz(3)
  note     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId, startsAt])
  @@map("schedule_exceptions")
}

enum ScheduleExceptionKind {
  vacation
  sick
  personal
  other

  @@map("schedule_exception_kind")
}

/// Аккаунт клиента: вход по email и паролю. Гостевая запись аккаунт не требует.
/// `passwordHash` — argon2id в формате PHC; NULL допустим, пока пароль не задан
/// (аккаунт мог появиться из другого канала, например подтверждения почты в PR2).
/// Подтверждение почты (`emailVerifiedAt`) в PR1 не заполняется.
model Client {
  id String @id @default(uuid()) @db.Uuid

  email        String    @unique
  passwordHash String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  loginTokens  LoginToken[]
  appointments Appointment[]

  @@map("clients")
}

/// Сессия входа: в БД лежит только SHA-256 от непрозрачного токена из httpOnly cookie.
/// `expiresAt` — срок по бездействию (продлевается при обращении), `createdAt` — начало
/// сессии: абсолютный срок (60 дней) считается от него и не продлевается.
model Session {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique @map("token_hash")

  clientId String @map("client_id") @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([clientId])
  @@map("sessions")
}

/// Одноразовая ссылка для входа и подтверждения email. В БД хранится только SHA-256 токена.
model LoginToken {
  id String @id @default(uuid()) @db.Uuid

  tokenHash String @unique @map("token_hash")
  clientId  String @map("client_id") @db.Uuid
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([clientId, consumedAt])
  @@map("login_tokens")
}

/// Гостевая запись на услугу. Персональные данные клиента маскируются в логах.
/// Непересечение слотов одного мастера обеспечивает EXCLUDE-констрейнт (см. миграцию).
/// `clientId` заполняется, когда запись создана из-под сессии; гостевые записи остаются
/// без аккаунта (`NULL`), а удаление аккаунта не удаляет историю визитов (`SetNull`).
model Appointment {
  id        String @id @default(uuid()) @db.Uuid
  masterId  String @map("master_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  clientName  String  @map("client_name")
  clientPhone String  @map("client_phone")
  clientEmail String? @map("client_email")

  clientId String? @map("client_id") @db.Uuid
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  status AppointmentStatus @default(pending)

  // Снимки условий на момент записи: изменение прайса не переписывает историю.
  priceKopecks Int @map("price_kopecks")
  durationMin  Int @map("duration_min")

  // Ключ идемпотентности от клиента: повтор запроса не создаёт дубль.
  idempotencyKey String? @unique @map("idempotency_key")

  cancelReason String? @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  master  Master  @relation(fields: [masterId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  outboxMessages OutboxMessage[]

  @@index([masterId, startsAt])
  @@index([serviceId])
  @@index([clientId])
  @@map("appointments")
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
  no_show

  @@map("appointment_status")
}

/// Очередь исходящих писем (transactional outbox).
/// Строка создаётся в одной транзакции с бизнес-событием (например, записью на услугу),
/// поэтому сбой отправки не ломает создание записи. Письма отправляет фоновый диспетчер.
/// Персональные данные (email, имя клиента, тело письма) лежат только в `payload` и в БД,
/// в логи попадают id записи/сообщения, `type` и код SMTP-ответа.
model OutboxMessage {
  id String @id @default(uuid()) @db.Uuid

  /// Тип письма (`booking_confirmation` и т. п.). Не enum: новый тип не требует миграции.
  type    String
  /// Снимок данных для рендера шаблона на момент события.
  payload Json
  status  OutboxStatus @default(pending)

  /// Число неудачных попыток отправки: по нему считается пауза перед повтором.
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// Текст последней ошибки (код SMTP, без содержимого письма). В логи не выводится.
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)

  appointmentId String?      @map("appointment_id") @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Выборка диспетчера: pending с наступившим `next_attempt_at`.
  @@index([status, nextAttemptAt])
  // Лимиты отправки (30/мин, 200/сутки) считаются по `sent_at`.
  @@index([sentAt])
  @@map("outbox_messages")
}

enum OutboxStatus {
  pending
  sent
  failed
  suppressed

  @@map("outbox_status")
}
