# nginx на хосте: единственная точка входа. Контейнеры слушают только 127.0.0.1.
# Скопировать в /etc/nginx/sites-available/hair-lab и заменить домен и пути к сертификатам.
# Сертификаты: certbot (Let's Encrypt) или существующие; пример ниже — LE.

upstream hair_lab_web {
    server 127.0.0.1:3000;
    keepalive 16;
}

upstream hair_lab_api {
    server 127.0.0.1:3001;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name strizhlab.ru www.strizhlab.ru;
    return 301 https://strizhlab.ru$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name strizhlab.ru;

    ssl_certificate     /etc/letsencrypt/live/strizhlab.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/strizhlab.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    client_max_body_size 4m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API: /api/health → 127.0.0.1:3001/health (префикс отрезается).
    location /api/ {
        proxy_pass http://hair_lab_api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Статика Next.js кэшируется агрессивно: имена файлов содержат хэш.
    location /_next/static/ {
        proxy_pass http://hair_lab_web;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://hair_lab_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
